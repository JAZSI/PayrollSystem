<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>



<VBox spacing="16" minWidth="300" maxWidth="340"
      xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1">

    
    <VBox styleClass="card">
        <HBox styleClass="card-header">
            <Label text="Quick Actions"
                   styleClass="card-header-title"/>
        </HBox>
        <VBox styleClass="card-body" spacing="8">
            <Button text="Run Payroll"
                    styleClass="btn-gold"
                    maxWidth="Infinity"
                    onAction="#computePayroll">
                <graphic>
                    <FontIcon iconLiteral="fas-calculator" iconSize="14"/>
                </graphic>
            </Button>
            <Button text="Add Employee"
                    styleClass="btn-primary"
                    maxWidth="Infinity"
                    onAction="#openAddEmployeeModal">
                <graphic>
                    <FontIcon iconLiteral="fas-user-plus" iconSize="14"/>
                </graphic>
            </Button>
            <Button text="Export Report"
                    styleClass="btn-outline"
                    maxWidth="Infinity"
                    onAction="#handleExport">
                <graphic>
                    <FontIcon iconLiteral="fas-download" iconSize="14"/>
                </graphic>
            </Button>
        </VBox>
    </VBox>

    
    <VBox styleClass="card">
        <HBox styleClass="card-header">
            <Label text="This Period"
                   styleClass="card-header-title"/>
            <Label text="Jun 1â€“15" styleClass="caption"/>
        </HBox>
        <VBox styleClass="card-body" spacing="12">

            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 16px;">
                    <graphic>
                        <FontIcon iconLiteral="fas-calendar-alt" iconSize="16"/>
                    </graphic>
                </Label>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Working Days" styleClass="text-small"/>
                    <Label text="10 days" styleClass="h5"/>
                </VBox>
            </HBox>

            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 16px;">
                    <graphic>
                        <FontIcon iconLiteral="fas-users" iconSize="16"/>
                    </graphic>
                </Label>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Present" styleClass="text-small"/>
                    <Label text="42 / 47" styleClass="h5"/>
                </VBox>
            </HBox>

            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 16px;">
                    <graphic>
                        <FontIcon iconLiteral="fas-times-circle" iconSize="16"/>
                    </graphic>
                </Label>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Absent" styleClass="text-small"/>
                    <Label text="5 employees" styleClass="h5"/>
                </VBox>
            </HBox>

            
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 16px;">
                    <graphic>
                        <FontIcon iconLiteral="fas-clock" iconSize="16"/>
                    </graphic>
                </Label>
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Overtime" styleClass="text-small"/>
                    <Label text="12.5 hours" styleClass="h5"/>
                </VBox>
            </HBox>

        </VBox>
    </VBox>

</VBox>

