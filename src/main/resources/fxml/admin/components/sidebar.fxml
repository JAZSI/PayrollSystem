<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>



<VBox styleClass="sidebar"
      xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      prefWidth="248"
      spacing="0">

    
    <HBox styleClass="sidebar-logo-pane" spacing="12" alignment="CENTER_LEFT">
        <ImageView styleClass="sidebar-logo-image"
                   fitWidth="36" fitHeight="36" preserveRatio="true">
            <image>
                <Image url="@/image/logo.png"/>
            </image>
        </ImageView>
        <VBox spacing="1">
            <Label text="NU Payroll" styleClass="sidebar-wordmark"/>
            <Label text="Admin Suite" styleClass="sidebar-suite-label"/>
        </VBox>
    </HBox>

    
    <VBox VBox.vgrow="ALWAYS" styleClass="sidebar-nav">
        
        
        <Label text="MAIN" styleClass="nav-section-label"/>
        <Button fx:id="navDashboard"
                text="Dashboard"
                styleClass="nav-item, active"
                onAction="#showDashboard"
                maxWidth="Infinity">
            <graphic>
                <FontIcon iconLiteral="fas-th-large" iconSize="14"/>
            </graphic>
        </Button>
        <Button fx:id="navEmployees"
                text="Employees"
                styleClass="nav-item"
                onAction="#showEmployees"
                maxWidth="Infinity">
            <graphic>
                <FontIcon iconLiteral="fas-users" iconSize="14"/>
            </graphic>
        </Button>
        <Button fx:id="navAttendance"
                text="Attendance"
                styleClass="nav-item"
                onAction="#showAttendance"
                maxWidth="Infinity">
            <graphic>
                <FontIcon iconLiteral="fas-clock" iconSize="14"/>
            </graphic>
        </Button>
        <Button fx:id="navPayroll"
                text="Payroll Run"
                styleClass="nav-item"
                onAction="#showPayroll"
                maxWidth="Infinity">
            <graphic>
                <FontIcon iconLiteral="fas-calculator" iconSize="14"/>
            </graphic>
        </Button>

        
        <Label text="RECORDS" styleClass="nav-section-label" style="-fx-padding: 14 20 4 20;"/>
        <Button fx:id="navReports"
                text="Reports"
                styleClass="nav-item"
                onAction="#showReports"
                maxWidth="Infinity">
            <graphic>
                <FontIcon iconLiteral="fas-file-alt" iconSize="14"/>
            </graphic>
        </Button>

        
        <Label text="SYSTEM" styleClass="nav-section-label" style="-fx-padding: 14 20 4 20;"/>
        <Button fx:id="navSettings"
                text="Settings"
                styleClass="nav-item"
                onAction="#showSettings"
                maxWidth="Infinity">
            <graphic>
                <FontIcon iconLiteral="fas-cog" iconSize="14"/>
            </graphic>
        </Button>
    </VBox>

    
    <HBox styleClass="sidebar-footer" spacing="10" alignment="CENTER_LEFT">
        <Label text="MA" styleClass="sidebar-avatar"
               minWidth="32" maxWidth="32" minHeight="32" maxHeight="32"
               alignment="CENTER"/>
        <VBox spacing="1" HBox.hgrow="ALWAYS">
            <Label text="Maria Aquino" styleClass="sidebar-user-name"/>
            <Label text="HR Administrator" styleClass="sidebar-user-role"/>
        </VBox>
        <Button fx:id="btnLogout"
                styleClass="btn-icon"
                onAction="#handleLogout">
            <graphic>
                <FontIcon iconLiteral="fas-sign-out-alt" iconSize="14"/>
            </graphic>
        </Button>
    </HBox>

</VBox>

