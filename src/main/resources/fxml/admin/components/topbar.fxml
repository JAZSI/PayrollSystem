<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>



<HBox styleClass="main-header"
      xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      alignment="CENTER_LEFT"
      spacing="14"
      fillHeight="true"
      style="-fx-padding: 12 20 12 20;">

    
    <Label text="Cut-off: June 1â€“15, 2026"
           styleClass="cutoff-chip"/>

    
    <Region HBox.hgrow="ALWAYS"/>

    
    <Button styleClass="header-bell-btn"
        onAction="#handleNotifications">
      <graphic>
        <FontIcon iconLiteral="fas-bell" iconSize="14"/>
      </graphic>
    </Button>

    
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="MA" styleClass="header-avatar"
               minWidth="32" maxWidth="32" minHeight="32" maxHeight="32"
               alignment="CENTER"/>
        <Label text="Maria Aquino" styleClass="header-username"/>
        <Label style="-fx-text-fill: #7A8FA6; -fx-font-size: 12px;">
          <graphic>
            <FontIcon iconLiteral="fas-angle-down" iconSize="12"/>
          </graphic>
        </Label>
    </HBox>

</HBox>

