<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>



<VBox fx:id="stateActive"
      spacing="18"
      alignment="CENTER"
      maxWidth="520"
      visible="false" managed="false"
      xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1">

    <VBox styleClass="emp-found-card" spacing="0">

        
        <HBox spacing="16" alignment="CENTER_LEFT"
              style="-fx-padding: 16;">
            <Label fx:id="empAvatarLabel"
                   text="JP"
                   styleClass="emp-avatar-circle"
                   minWidth="64" maxWidth="64"
                   minHeight="64" maxHeight="64"
                   alignment="CENTER"/>
            <VBox HBox.hgrow="ALWAYS" spacing="4">
                <Label fx:id="empNameLabel"
                       text="Santos, Juan Pablo T."
                       styleClass="emp-found-name"
                       wrapText="true"/>
                <Label fx:id="empIdLabel"
                       text="EMP-001 Â· Engineering"
                       styleClass="emp-found-id"/>
            </VBox>
        </HBox>

        
        <HBox spacing="8" style="-fx-padding: 0 0 16 16;">
            <Label fx:id="empTypeBadge"
                   text="Regular"
                   styleClass="badge-regular"/>
            <Label fx:id="empHolidayBadge"
                   text="Special Holiday"
                   styleClass="badge-holiday"
                   visible="false" managed="false"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER" style="-fx-padding: 0 16 16 16;">
            <FontIcon iconLiteral="fas-info-circle" iconSize="14" styleClass="text-muted"/>
            <Label text="This kiosk clocks in/out automatically after scan."
               styleClass="text-muted"
               wrapText="true"
               maxWidth="360"/>
        </HBox>

    </VBox>

</VBox>

