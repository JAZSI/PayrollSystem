<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>



<VBox fx:id="stateSuccessIn"
      spacing="20"
      alignment="CENTER"
      maxWidth="520"
      visible="false" managed="false"
      xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1">

    <VBox styleClass="success-card" spacing="16">
        <Label styleClass="success-icon">
            <graphic>
                <FontIcon iconLiteral="fas-check-circle" iconSize="24"/>
            </graphic>
        </Label>
        <Label text="Time In Recorded" styleClass="success-title"/>
        <Label fx:id="successTimeLabel"
               text="08:00 AM"
               styleClass="success-time"/>
        <Label text="Returning to idle screen..."
               styleClass="success-countdown"/>
    </VBox>

</VBox>

