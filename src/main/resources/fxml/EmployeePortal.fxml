<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>



<StackPane
       xmlns="http://javafx.com/javafx/20"
    xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="com.com253.payrollsystem.presentation.gui.controller.EmployeePortalController"
       stylesheets="@/css/EmployeePortal.css"
    prefWidth="1100" prefHeight="760"
    style="-fx-background-color: #F2F0EB;">

    
    <VBox fx:id="loginScreen"
          styleClass="login-root"
          alignment="CENTER"
          prefWidth="1100" prefHeight="760">

        <VBox styleClass="login-card"
              alignment="CENTER"
              maxWidth="420" minWidth="380"
              spacing="0">

            
            <VBox alignment="CENTER" spacing="8"
                  style="-fx-padding: 0 0 12 0;">
                                          <ImageView styleClass="login-logo-image"
                                             fitWidth="64" fitHeight="64" preserveRatio="true">
                                   <image>
                                          <Image url="@/image/logo.png"/>
                                   </image>
                            </ImageView>
                <Label text="NU Payroll" styleClass="login-wordmark"/>
                <Label text="EMPLOYEE SELF-SERVICE PORTAL" styleClass="login-subtitle"/>
            </VBox>

            
            <Region styleClass="login-divider"
                    minHeight="1" maxHeight="1"
                    style="-fx-padding: 0 0 12 0;"/>

            
            <Label text="Sign In to Your Account"
                   styleClass="login-title"
                   style="-fx-padding: 14 0 18 0;"/>

            
            <VBox spacing="14"
                  style="-fx-padding: 0 0 16 0;"
                  maxWidth="9999" fillWidth="true">

                
                <VBox spacing="5">
                    <Label text="EMPLOYEE ID" styleClass="field-label"/>
                    <TextField fx:id="loginIdField"
                               styleClass="field-input"
                               promptText="e.g. EMP-001"
                               text="EMP-001"/>
                </VBox>

                
                <VBox spacing="5">
                    <Label text="PIN / PASSWORD" styleClass="field-label"/>
                    <PasswordField fx:id="loginPinField"
                                  styleClass="field-input"
                                  promptText="Enter your PIN"/>
                </VBox>

                
                <Button fx:id="loginBtn"
                        text="Sign In"
                        styleClass="btn-login"
                        onAction="#handleLogin"
                        maxWidth="Infinity"/>
            </VBox>

            
            <Label text="Forgot your PIN? Contact HR at ext. 100"
                   styleClass="login-hint"/>

        </VBox>
    </VBox>

    
    <VBox fx:id="dashboardScreen"
          visible="false"
          prefWidth="1100" prefHeight="760">

        
        <HBox styleClass="app-header"
              alignment="CENTER_LEFT"
              spacing="14" fillHeight="true">

            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <ImageView styleClass="header-logo"
                           fitWidth="34" fitHeight="34" preserveRatio="true">
                    <image>
                        <Image url="@/image/logo.png"/>
                    </image>
                </ImageView>
                <Label text="NU Payroll" styleClass="header-wordmark"/>
            </HBox>

            
            <Region styleClass="header-sep"/>

            
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Welcome, " styleClass="header-greeting"/>
                <Label fx:id="greetingName"
                       text="JC Senoto"
                       styleClass="header-greeting-name"/>
            </HBox>

            
            <Region HBox.hgrow="ALWAYS"/>

            
            <Label text="Regular Employee" styleClass="header-badge"/>

            
                     <Button styleClass="header-bell-btn"
                                   onAction="#handleNotifications">
                            <graphic>
                                   <FontIcon iconLiteral="fas-bell" iconSize="14"/>
                            </graphic>
                     </Button>

            
            <Button text="Sign Out"
                    styleClass="header-logout-btn"
                    onAction="#handleLogout"/>

        </HBox>

        
        <ScrollPane VBox.vgrow="ALWAYS"
                    fitToWidth="true"
                    styleClass="scroll-pane">

            <VBox styleClass="dashboard-root"
                  spacing="20" fillWidth="true">

                
                <VBox styleClass="card">

                    
                    <HBox styleClass="card-header"
                          alignment="CENTER_LEFT">
                                          <Label text="My Attendance"
                                                    styleClass="card-title"
                                                    HBox.hgrow="ALWAYS">
                                                 <graphic>
                                                        <FontIcon iconLiteral="fas-clock" iconSize="14"/>
                                                 </graphic>
                                          </Label>
                        <Label text="June 2026"
                               styleClass="card-header-meta"/>
                    </HBox>

                    
                    <HBox styleClass="tab-bar" spacing="0">
                        <Button fx:id="attTab1"
                                text="1st Cut-off   Jun 1-15"
                                styleClass="tab-btn, active"
                                onAction="#switchToFirstCutoff"/>
                        <Button fx:id="attTab2"
                                text="2nd Cut-off   Jun 16-30"
                                styleClass="tab-btn"
                                onAction="#switchToSecondCutoff"/>
                    </HBox>

                    
                    <TableView fx:id="attendanceTable"
                               styleClass="att-table"
                               prefHeight="340"
                               maxWidth="Infinity">

                        <columns>
                            <TableColumn fx:id="attColDay"
                                         text="DAY" prefWidth="60"/>
                            <TableColumn fx:id="attColDate"
                                         text="DATE" prefWidth="90"/>
                            <TableColumn fx:id="attColIn"
                                         text="TIME IN" prefWidth="100"/>
                            <TableColumn fx:id="attColOut"
                                         text="TIME OUT" prefWidth="100"/>
                            <TableColumn fx:id="attColHrs"
                                         text="HOURS" prefWidth="80"/>
                            <TableColumn fx:id="attColOt"
                                         text="OT" prefWidth="70"/>
                            <TableColumn fx:id="attColUt"
                                         text="UNDERTIME" prefWidth="100"/>
                            <TableColumn fx:id="attColStatus"
                                         text="STATUS" prefWidth="120"/>
                        </columns>

                        <placeholder>
                            <Label text="No attendance records for this cut-off."
                                   style="-fx-text-fill: #7A8FA6;"/>
                        </placeholder>
                    </TableView>

                    
                    <HBox styleClass="summary-strip"
                          fillHeight="true">

                        <VBox styleClass="sum-cell" HBox.hgrow="ALWAYS"
                              alignment="CENTER">
                            <Label text="HOURS WORKED" styleClass="sum-label"/>
                            <Label fx:id="sumHours" text="0.0" styleClass="sum-value"/>
                        </VBox>
                        <VBox styleClass="sum-cell" HBox.hgrow="ALWAYS"
                              alignment="CENTER">
                            <Label text="OT HOURS" styleClass="sum-label"/>
                            <Label fx:id="sumOT" text="0.0" styleClass="sum-value"/>
                        </VBox>
                        <VBox styleClass="sum-cell" HBox.hgrow="ALWAYS"
                              alignment="CENTER">
                            <Label text="UNDERTIME" styleClass="sum-label"/>
                            <Label fx:id="sumUT" text="0.0" styleClass="sum-value"/>
                        </VBox>
                        <VBox styleClass="sum-cell" HBox.hgrow="ALWAYS"
                              alignment="CENTER">
                            <Label text="ABSENCES" styleClass="sum-label"/>
                            <Label fx:id="sumAbsent" text="0" styleClass="sum-value"/>
                        </VBox>
                        <VBox styleClass="sum-cell" HBox.hgrow="ALWAYS"
                              alignment="CENTER">
                            <Label text="WORKING DAYS" styleClass="sum-label"/>
                            <Label fx:id="sumWorkDays" text="0" styleClass="sum-value"/>
                        </VBox>

                    </HBox>

                </VBox>
                

                
                <VBox styleClass="card">

                    
                    <HBox styleClass="card-header" alignment="CENTER_LEFT">
                                          <Label text="My Payslip"
                                                    styleClass="card-title"
                                                    HBox.hgrow="ALWAYS">
                                                 <graphic>
                                                        <FontIcon iconLiteral="fas-file-invoice-dollar" iconSize="14"/>
                                                 </graphic>
                                          </Label>
                        <Label fx:id="payslipPeriodLabel"
                               text="Jun 1-15, 2026"
                               styleClass="period-chip"/>
                    </HBox>

                    
                    <VBox styleClass="payslip-container" spacing="0">
                        <VBox styleClass="payslip-card">

                            
                            <VBox styleClass="payslip-header" spacing="4">
                                <Label text="NATIONAL UNIVERSITY - PAYROLL SYSTEM"
                                       styleClass="payslip-company"/>
                                <Label fx:id="payslipTitle"
                                       text="Payslip - Jun 1-15, 2026"
                                       styleClass="payslip-title"/>
                                <GridPane hgap="12" vgap="4"
                                          style="-fx-padding: 10 0 0 0;">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Label text="Employee:" styleClass="payslip-meta-label"
                                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                    <Label text="JC Senoto"
                                           styleClass="payslip-meta-value"
                                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                    <Label text="ID:" styleClass="payslip-meta-label"
                                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                    <Label text="EMP-001" styleClass="payslip-meta-value"
                                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                    <Label text="Type:" styleClass="payslip-meta-label"
                                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                                    <Label text="Regular" styleClass="payslip-meta-value"
                                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                                    <Label text="Dept:" styleClass="payslip-meta-label"
                                           GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                                    <Label text="Engineering" styleClass="payslip-meta-value"
                                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                                </GridPane>
                            </VBox>

                            
                            <VBox styleClass="payslip-section" spacing="6">
                                <Label text="EARNINGS" styleClass="payslip-section-title"/>

                                <HBox>
                                    <Label text="Basic Pay"
                                           styleClass="payslip-row-label"
                                           HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="slipBasic"
                                           text="PHP 15,835.23"
                                           styleClass="payslip-row-amount"/>
                                </HBox>
                                <HBox>
                                    <Label text="Overtime Pay (2.0 hrs x PHP 215.91 x 1.25)"
                                           styleClass="payslip-row-label"
                                           HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="slipOT"
                                           text="PHP 539.77"
                                           styleClass="payslip-row-amount"/>
                                </HBox>

                                <Separator/>

                                <HBox>
                                    <Label text="Gross Pay"
                                           styleClass="payslip-subtotal-label"
                                           HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="slipGross"
                                           text="PHP 16,375.00"
                                           styleClass="payslip-subtotal-label"/>
                                </HBox>
                            </VBox>

                            
                            <VBox styleClass="payslip-section" spacing="6">
                                <Label text="DEDUCTIONS" styleClass="payslip-section-title"/>

                                <HBox>
                                    <Label text="SSS Contribution"
                                           styleClass="payslip-row-label" HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="slipSSS"
                                           text="(PHP 900.00)"
                                           styleClass="payslip-row-deduction"/>
                                </HBox>
                                <HBox>
                                    <Label text="PhilHealth"
                                           styleClass="payslip-row-label" HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="slipPH"
                                           text="(PHP 750.00)"
                                           styleClass="payslip-row-deduction"/>
                                </HBox>
                                <HBox>
                                    <Label text="Pag-IBIG"
                                           styleClass="payslip-row-label" HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="slipPIG"
                                           text="(PHP 100.00)"
                                           styleClass="payslip-row-deduction"/>
                                </HBox>
                                <HBox>
                                    <Label text="Withholding Tax (BIR)"
                                           styleClass="payslip-row-label" HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="slipTax"
                                           text="(PHP 2,150.00)"
                                           styleClass="payslip-row-deduction"/>
                                </HBox>
                                <HBox>
                                    <Label text="Loan Deduction"
                                           styleClass="payslip-row-label" HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="slipLoan"
                                           text="(PHP 2,500.00)"
                                           styleClass="payslip-row-deduction"/>
                                </HBox>
                                <HBox>
                                    <Label text="Absence Penalty (1 day)"
                                           styleClass="payslip-row-label" HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="slipAbsent"
                                           text="(PHP 1,227.27)"
                                           styleClass="payslip-row-deduction"/>
                                </HBox>
                                <HBox>
                                    <Label text="Undertime Penalty"
                                           styleClass="payslip-row-label" HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="slipUT"
                                           text="(PHP 15.34)"
                                           styleClass="payslip-row-deduction"/>
                                </HBox>

                                <Separator/>

                                <HBox>
                                    <Label text="Total Deductions"
                                           styleClass="payslip-subtotal-label"
                                           HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="slipTotalDed"
                                           text="(PHP 7,642.61)"
                                           style="-fx-font-weight: bold; -fx-text-fill: #991B1B;
                                                  -fx-font-family: 'JetBrains Mono', monospace;
                                                  -fx-font-size: 12px;"/>
                                </HBox>
                            </VBox>

                            
                            <HBox styleClass="payslip-net-bar" alignment="CENTER_LEFT">
                                <Label text="NET PAY"
                                       styleClass="payslip-net-label"
                                       HBox.hgrow="ALWAYS"/>
                                <Label fx:id="slipNetPay"
                                       text="PHP 8,732.39"
                                       styleClass="payslip-net-amount"/>
                            </HBox>

                            
                            <HBox styleClass="payslip-actions" spacing="10">
                                                        <Button text="Download PDF"
                                                                      styleClass="btn-gold"
                                                                      onAction="#handleDownloadPdf">
                                                               <graphic>
                                                                      <FontIcon iconLiteral="fas-file-pdf" iconSize="14"/>
                                                               </graphic>
                                                        </Button>
                                                        <Button text="Print"
                                                                      styleClass="btn-outline"
                                                                      onAction="#handlePrint">
                                                               <graphic>
                                                                      <FontIcon iconLiteral="fas-print" iconSize="14"/>
                                                               </graphic>
                                                        </Button>
                            </HBox>

                        </VBox>
                    </VBox>

                </VBox>
                

            </VBox>
        </ScrollPane>

    </VBox>
    

</StackPane>

