<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>



<VBox
    xmlns="http://javafx.com/javafx/20"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.com253.payrollsystem.presentation.gui.controller.EmployeePortalController"
    prefWidth="1100" prefHeight="760"
    spacing="0">

    
    <HBox styleClass="app-header"
          alignment="CENTER_LEFT"
          spacing="14" fillHeight="true"
          style="-fx-padding: 12 20 12 20;">

        
        <HBox alignment="CENTER_LEFT" spacing="10">
            <ImageView styleClass="header-logo"
                       fitWidth="34" fitHeight="34" preserveRatio="true">
                <image>
                    <Image url="@/image/logo.png"/>
                </image>
            </ImageView>
            <Label text="NU Payroll" styleClass="header-wordmark"/>
        </HBox>

        
        <Region styleClass="header-sep"/>

        
        <HBox spacing="4" alignment="CENTER_LEFT">
            <Label text="Welcome, " styleClass="header-greeting"/>
            <Label fx:id="greetingName"
                   text="JC Senoto"
                   styleClass="header-greeting-name"/>
        </HBox>

        
        <Region HBox.hgrow="ALWAYS"/>

        
        <Label text="Regular Employee" styleClass="header-badge"/>

        
        <Button styleClass="header-bell-btn"
                onAction="#handleNotifications">
            <graphic>
                <FontIcon iconLiteral="fas-bell" iconSize="14"/>
            </graphic>
        </Button>

        
        <Button text="Sign Out"
                styleClass="header-logout-btn"
                onAction="#handleLogout"/>

    </HBox>

    
    <TabPane VBox.vgrow="ALWAYS"
             style="-fx-border-width: 0;">

        
        <Tab closable="false">
            <graphic>
                <FontIcon iconLiteral="fas-chart-bar" iconSize="14"/>
            </graphic>
            <text>My Attendance</text>
            <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                <VBox styleClass="dashboard-root"
                      spacing="16"
                      fillWidth="true"
                      style="-fx-padding: 20;">

                    
                    <VBox styleClass="card">

                        
                        <HBox styleClass="card-header"
                              alignment="CENTER_LEFT">
                            <Label text="My Attendance"
                                   styleClass="card-title"
                                   HBox.hgrow="ALWAYS">
                                <graphic>
                                    <FontIcon iconLiteral="fas-clock" iconSize="14"/>
                                </graphic>
                            </Label>
                            <Label text="June 2026"
                                   styleClass="card-header-meta"/>
                        </HBox>

                        
                        <HBox styleClass="tab-bar" spacing="0">
                            <Button fx:id="attTab1"
                                    text="1st Cut-off   Jun 1-15"
                                    styleClass="tab-btn, active"
                                    onAction="#switchToFirstCutoff"/>
                            <Button fx:id="attTab2"
                                    text="2nd Cut-off   Jun 16-30"
                                    styleClass="tab-btn"
                                    onAction="#switchToSecondCutoff"/>
                        </HBox>

                        
                        <TableView fx:id="attendanceTable"
                                   styleClass="att-table"
                                   prefHeight="280"
                                   maxWidth="Infinity">

                            <columns>
                                <TableColumn fx:id="attColDay" text="DAY" prefWidth="60"/>
                                <TableColumn fx:id="attColDate" text="DATE" prefWidth="90"/>
                                <TableColumn fx:id="attColIn" text="TIME IN" prefWidth="100"/>
                                <TableColumn fx:id="attColOut" text="TIME OUT" prefWidth="100"/>
                                <TableColumn fx:id="attColHrs" text="HOURS" prefWidth="80"/>
                                <TableColumn fx:id="attColOt" text="OT" prefWidth="70"/>
                                <TableColumn fx:id="attColUt" text="UNDERTIME" prefWidth="100"/>
                                <TableColumn fx:id="attColStatus" text="STATUS" prefWidth="120"/>
                            </columns>

                            <placeholder>
                                <Label text="No attendance records for this cut-off. This will be populated from the Attendance service."/>
                            </placeholder>
                        </TableView>

                        
                        <HBox styleClass="summary-strip"
                              fillHeight="true">

                            <VBox styleClass="sum-cell" HBox.hgrow="ALWAYS" alignment="CENTER">
                                <Label text="HOURS WORKED" styleClass="sum-label"/>
                                <Label fx:id="sumHours" text="0.0" styleClass="sum-value"/>
                            </VBox>
                            <VBox styleClass="sum-cell" HBox.hgrow="ALWAYS" alignment="CENTER">
                                <Label text="OT HOURS" styleClass="sum-label"/>
                                <Label fx:id="sumOT" text="0.0" styleClass="sum-value"/>
                            </VBox>
                            <VBox styleClass="sum-cell" HBox.hgrow="ALWAYS" alignment="CENTER">
                                <Label text="UNDERTIME" styleClass="sum-label"/>
                                <Label fx:id="sumUT" text="0.0" styleClass="sum-value"/>
                            </VBox>
                            <VBox styleClass="sum-cell" HBox.hgrow="ALWAYS" alignment="CENTER">
                                <Label text="ABSENCES" styleClass="sum-label"/>
                                <Label fx:id="sumAbsent" text="0" styleClass="sum-value"/>
                            </VBox>
                            <VBox styleClass="sum-cell" HBox.hgrow="ALWAYS" alignment="CENTER">
                                <Label text="WORKING DAYS" styleClass="sum-label"/>
                                <Label fx:id="sumWorkDays" text="0" styleClass="sum-value"/>
                            </VBox>

                        </HBox>

                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        
        <Tab closable="false">
            <graphic>
                <FontIcon iconLiteral="fas-file-invoice-dollar" iconSize="14"/>
            </graphic>
            <text>My Payslip</text>
            <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                <VBox styleClass="dashboard-root"
                      spacing="16"
                      fillWidth="true"
                      style="-fx-padding: 20;">

                    
                    <VBox styleClass="card">

                        
                        <HBox styleClass="card-header" alignment="CENTER_LEFT">
                            <Label text="My Payslip"
                                   styleClass="card-title"
                                   HBox.hgrow="ALWAYS">
                                <graphic>
                                    <FontIcon iconLiteral="fas-file-invoice-dollar" iconSize="14"/>
                                </graphic>
                            </Label>
                            <Label fx:id="payslipPeriodLabel"
                                   text="Jun 1-15, 2026"
                                   styleClass="period-chip"/>
                        </HBox>

                        
                        <VBox styleClass="payslip-container" spacing="0">
                            <VBox styleClass="payslip-card">

                                
                                <VBox styleClass="payslip-header" spacing="4"
                                      style="-fx-padding: 20;">
                                    <Label text="NATIONAL UNIVERSITY - PAYROLL SYSTEM"
                                           styleClass="payslip-company"/>
                                    <Label fx:id="payslipTitle"
                                           text="Payslip - Jun 1-15, 2026"
                                           styleClass="payslip-title"/>
                                </VBox>

                                
                                <VBox styleClass="payslip-body"
                                      style="-fx-padding: 20; -fx-spacing: 16;">
                                    <Label text="Payslip details will be populated from the Payroll service."
                                           styleClass="text-muted"/>
                                    <Button text="Download Payslip (PDF)"
                                            styleClass="btn-outline"
                                            onAction="#downloadPayslip"/>
                                </VBox>

                            </VBox>
                        </VBox>

                    </VBox>

                </VBox>
            </ScrollPane>
        </Tab>

        
        <Tab closable="false">
            <graphic>
                <FontIcon iconLiteral="fas-umbrella-beach" iconSize="14"/>
            </graphic>
            <text>Leave Management</text>
            <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                <VBox styleClass="dashboard-root"
                      spacing="16"
                      fillWidth="true"
                      style="-fx-padding: 20;">

                    <Label text="Leave Request / History" styleClass="h3"/>
                    <Label text="Leave management features coming soon. This will be connected to the Leave service."
                           styleClass="text-muted"/>

                </VBox>
            </ScrollPane>
        </Tab>

    </TabPane>

</VBox>

