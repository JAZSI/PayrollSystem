<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>



<VBox
       xmlns="http://javafx.com/javafx/20"
    xmlns:fx="http://javafx.com/fxml/1"
       fx:controller="com.com253.payrollsystem.presentation.gui.controller.KioskTerminalController"
       stylesheets="@/css/KioskTerminal.css"
    styleClass="kiosk-root"
    prefWidth="900" prefHeight="720"
    spacing="0">

    
    <Region styleClass="gold-stripe" minHeight="3" maxHeight="3" maxWidth="Infinity"/>

    
    <HBox styleClass="scan-strip" alignment="CENTER_LEFT" spacing="12">

        
        <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <Circle fx:id="scanPulse" radius="5" styleClass="scan-pulse-indicator"/>
            <Label text="RFID / Barcode reader ready" styleClass="scan-label"/>
        </HBox>

        
        <VBox alignment="CENTER_RIGHT" spacing="1">
            <Label fx:id="clockLabel" text="00:00:00" styleClass="clock-time"/>
            <Label fx:id="dateLabel"  text="Mon, Jan 01 2026" styleClass="clock-date"/>
        </VBox>

    </HBox>

    
    <HBox styleClass="state-tab-bar" alignment="CENTER" spacing="6"
          style="-fx-padding: 8 32 8 32;">
        <Button fx:id="tabIdle"
                text="Idle"
                styleClass="state-tab, active"
                onAction="#showIdle"/>
        <Button fx:id="tabActive"
                text="Active"
                styleClass="state-tab"
                onAction="#showActive"/>
        <Button fx:id="tabSuccessIn"
                text="Success (In)"
                styleClass="state-tab"
                onAction="#showSuccessIn"/>
        <Button fx:id="tabSuccessOut"
                text="Success (Out)"
                styleClass="state-tab"
                onAction="#showSuccessOut"/>
        <Button fx:id="tabErrorNF"
                text="Not Found"
                styleClass="state-tab"
                onAction="#showErrorNotFound"/>
        <Button fx:id="tabErrorDup"
                text="Already Timed"
                styleClass="state-tab"
                onAction="#showErrorDuplicate"/>
    </HBox>

    
    <StackPane styleClass="kiosk-body"
               VBox.vgrow="ALWAYS"
               alignment="CENTER">

        
        <VBox fx:id="stateIdle"
              styleClass="screen-container"
              spacing="20"
              alignment="CENTER"
              maxWidth="520"
              visible="true" managed="true">

            
            <VBox alignment="CENTER" spacing="10">
                <VBox styleClass="logo-icon-wrap" alignment="CENTER">
                                   <ImageView styleClass="logo-icon-image"
                                                    fitWidth="52" fitHeight="52" preserveRatio="true">
                                          <image>
                                                 <Image url="@/image/logo.png"/>
                                          </image>
                                   </ImageView>
                </VBox>
                <Label text="NU Payroll" styleClass="kiosk-app-name"/>
                <Label text="EMPLOYEE TIME TERMINAL" styleClass="kiosk-app-sub"/>
            </VBox>

            
            <Label text="Tap your ID or enter your employee number"
                   styleClass="prompt-main"
                   wrapText="true"
                   maxWidth="460"
                   alignment="CENTER"/>
            <Label text="Use the keypad below or scan your company ID card"
                   styleClass="prompt-sub"
                   wrapText="true"
                   maxWidth="420"
                   alignment="CENTER"/>

            
            <HBox styleClass="input-display-pane"
                  fx:id="inputDisplayPane"
                  alignment="CENTER_LEFT"
                  spacing="8"
                  maxWidth="9999">
                <Label fx:id="inputValueLabel"
                       text="Enter employee IDâ€¦"
                       styleClass="input-value-label, empty"
                       HBox.hgrow="ALWAYS"/>
                            <Button styleClass="input-clear-btn"
                                          onAction="#handleBackspace">
                                   <graphic>
                                          <FontIcon iconLiteral="fas-backspace" iconSize="14"/>
                                   </graphic>
                            </Button>
            </HBox>

            
            <GridPane fx:id="keypadGrid"
                      styleClass="keypad-grid"
                      hgap="10" vgap="10"
                      alignment="CENTER"
                      maxWidth="9999">

                
                <Button text="1" styleClass="key-btn"
                        GridPane.columnIndex="0" GridPane.rowIndex="0"
                        maxWidth="Infinity"
                        onAction="#handleKey1"/>
                <Button text="2" styleClass="key-btn"
                        GridPane.columnIndex="1" GridPane.rowIndex="0"
                        maxWidth="Infinity"
                        onAction="#handleKey2"/>
                <Button text="3" styleClass="key-btn"
                        GridPane.columnIndex="2" GridPane.rowIndex="0"
                        maxWidth="Infinity"
                        onAction="#handleKey3"/>

                
                <Button text="4" styleClass="key-btn"
                        GridPane.columnIndex="0" GridPane.rowIndex="1"
                        maxWidth="Infinity"
                        onAction="#handleKey4"/>
                <Button text="5" styleClass="key-btn"
                        GridPane.columnIndex="1" GridPane.rowIndex="1"
                        maxWidth="Infinity"
                        onAction="#handleKey5"/>
                <Button text="6" styleClass="key-btn"
                        GridPane.columnIndex="2" GridPane.rowIndex="1"
                        maxWidth="Infinity"
                        onAction="#handleKey6"/>

                
                <Button text="7" styleClass="key-btn"
                        GridPane.columnIndex="0" GridPane.rowIndex="2"
                        maxWidth="Infinity"
                        onAction="#handleKey7"/>
                <Button text="8" styleClass="key-btn"
                        GridPane.columnIndex="1" GridPane.rowIndex="2"
                        maxWidth="Infinity"
                        onAction="#handleKey8"/>
                <Button text="9" styleClass="key-btn"
                        GridPane.columnIndex="2" GridPane.rowIndex="2"
                        maxWidth="Infinity"
                        onAction="#handleKey9"/>

                
                <Button text="0" styleClass="key-btn-zero"
                        GridPane.columnIndex="0" GridPane.rowIndex="3"
                        GridPane.columnSpan="2"
                        maxWidth="Infinity"
                        onAction="#handleKey0"/>
                            <Button styleClass="key-btn-back"
                        GridPane.columnIndex="2" GridPane.rowIndex="3"
                        maxWidth="Infinity"
                                          onAction="#handleBackspace">
                                   <graphic>
                                          <FontIcon iconLiteral="fas-backspace" iconSize="14"/>
                                   </graphic>
                            </Button>

                
                            <Button fx:id="submitBtn"
                                          text="Submit"
                                          styleClass="key-btn-submit"
                                          GridPane.columnIndex="0" GridPane.rowIndex="4"
                                          GridPane.columnSpan="3"
                                          maxWidth="Infinity"
                                          onAction="#handleSubmit">
                                   <graphic>
                                          <FontIcon iconLiteral="fas-arrow-right" iconSize="14"/>
                                   </graphic>
                            </Button>

                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                </columnConstraints>

            </GridPane>

            <Label text="Screen resets after 10 seconds of inactivity"
                   styleClass="reset-note"/>

        </VBox>
        

        
        <VBox fx:id="stateActive"
              spacing="18"
              alignment="CENTER"
              maxWidth="520"
              visible="false" managed="false">

            <VBox styleClass="emp-found-card" spacing="0">

                
                <Region styleClass="emp-found-card-stripe"
                        minHeight="3" maxHeight="3"
                        maxWidth="Infinity"
                                          >
                                   <VBox.margin>
                                          <Insets top="-26" right="-26" bottom="0" left="-26"/>
                                   </VBox.margin>
                            </Region>

                
                <HBox spacing="16" alignment="CENTER_LEFT"
                      style="-fx-padding: 0 0 12 0;">
                    <Label fx:id="empAvatarLabel"
                           text="JP"
                           styleClass="emp-avatar-circle"
                           minWidth="64" maxWidth="64"
                           minHeight="64" maxHeight="64"
                           alignment="CENTER"/>
                    <VBox HBox.hgrow="ALWAYS" spacing="4">
                        <Label fx:id="empNameLabel"
                               text="JC Senoto"
                               styleClass="emp-found-name"
                               wrapText="true"/>
                        <Label fx:id="empIdLabel"
                               text="EMP-001 Â· Engineering"
                               styleClass="emp-found-id"/>
                    </VBox>
                </HBox>

                
                <HBox spacing="8" style="-fx-padding: 0 0 16 0;">
                    <Label fx:id="empTypeBadge"
                           text="Regular"
                           styleClass="badge-regular"/>
                    <Label fx:id="empHolidayBadge"
                           text="Special Holiday"
                           styleClass="badge-holiday"
                           visible="false" managed="false"/>
                </HBox>

                            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 6 16 16 16;">
                                   <FontIcon iconLiteral="fas-info-circle" iconSize="14" styleClass="text-muted"/>
                                   <Label text="This kiosk records time automatically after scan; no manual Time In/Out buttons."
                                             styleClass="text-muted"
                                             wrapText="true"
                                             maxWidth="360"/>
                            </HBox>

            </VBox>

            <Label text="Session ends in 30 seconds of inactivity"
                   styleClass="reset-note"/>

        </VBox>
        

        
        <VBox fx:id="stateSuccessIn"
              styleClass="success-card"
              spacing="14"
              alignment="CENTER"
              maxWidth="520"
              visible="false" managed="false">

            
                     <Label styleClass="success-icon-in"
                               minWidth="72" maxWidth="72"
                               minHeight="72" maxHeight="72"
                               alignment="CENTER">
                            <graphic>
                                   <FontIcon iconLiteral="fas-check-circle" iconSize="28"/>
                            </graphic>
                     </Label>

            
            <Label fx:id="successInName"
                   text="JC Senoto"
                   styleClass="success-name"
                   wrapText="true"
                   maxWidth="420"
                   alignment="CENTER"/>

            
            <Label text="Timed In Successfully"
                   styleClass="success-action-badge-in"/>

            
            <Label fx:id="successInTimestamp"
                   text="10 Jun 2026 Â· 08:02:14 AM"
                   styleClass="success-timestamp"/>

            
            <VBox spacing="6" maxWidth="9999">
                <StackPane alignment="CENTER_LEFT" minHeight="5" maxHeight="5">
                    <Region styleClass="countdown-track" maxWidth="Infinity"/>
                    <Region fx:id="countdownFillIn"
                            styleClass="countdown-fill"
                            maxWidth="Infinity"/>
                </StackPane>
                <Label fx:id="countdownLabelIn"
                       text="Returning to home in 10sâ€¦"
                       styleClass="countdown-label"
                       maxWidth="Infinity"
                       alignment="CENTER"/>
            </VBox>

                     <Button text="Back to Home"
                                   styleClass="btn-return-home"
                                   onAction="#goToIdle">
                            <graphic>
                                   <FontIcon iconLiteral="fas-home" iconSize="14"/>
                            </graphic>
                     </Button>

        </VBox>
        

        
        <VBox fx:id="stateSuccessOut"
              styleClass="success-card"
              spacing="14"
              alignment="CENTER"
              maxWidth="520"
              visible="false" managed="false">

            
                     <Label styleClass="success-icon-out"
                               minWidth="72" maxWidth="72"
                               minHeight="72" maxHeight="72"
                               alignment="CENTER">
                            <graphic>
                                   <FontIcon iconLiteral="fas-check-circle" iconSize="28"/>
                            </graphic>
                     </Label>

            
            <Label fx:id="successOutName"
                   text="De Guzman, Liza T."
                   styleClass="success-name"
                   wrapText="true"
                   maxWidth="420"
                   alignment="CENTER"/>

            
            <Label text="Timed Out Successfully"
                   styleClass="success-action-badge-out"/>

            
            <Label fx:id="successOutTimestamp"
                   text="10 Jun 2026 Â· 05:34:07 PM"
                   styleClass="success-timestamp"/>

            
            <VBox spacing="6" maxWidth="9999">
                <StackPane alignment="CENTER_LEFT" minHeight="5" maxHeight="5">
                    <Region styleClass="countdown-track" maxWidth="Infinity"/>
                    <Region fx:id="countdownFillOut"
                            styleClass="countdown-fill"
                            maxWidth="Infinity"/>
                </StackPane>
                <Label fx:id="countdownLabelOut"
                       text="Returning to home in 10sâ€¦"
                       styleClass="countdown-label"
                       maxWidth="Infinity"
                       alignment="CENTER"/>
            </VBox>

                     <Button text="Back to Home"
                                   styleClass="btn-return-home"
                                   onAction="#goToIdle">
                            <graphic>
                                   <FontIcon iconLiteral="fas-home" iconSize="14"/>
                            </graphic>
                     </Button>

        </VBox>
        

        
        <VBox fx:id="stateErrorNF"
              styleClass="error-card-not-found"
              spacing="14"
              alignment="CENTER"
              maxWidth="520"
              visible="false" managed="false">

                     <Label styleClass="error-icon-red"
                               alignment="CENTER">
                            <graphic>
                                   <FontIcon iconLiteral="fas-times-circle" iconSize="28"/>
                            </graphic>
                     </Label>

            <Label text="Employee Not Found"
                   styleClass="error-title"/>

            <Label fx:id="errorNFMessage"
                   text="No record matches EMP-999.
Please check your ID number or contact HR at ext. 100."
                   styleClass="error-message"
                   wrapText="true"
                   maxWidth="400"
                   alignment="CENTER"/>

                     <Button text="Return to Home"
                                   styleClass="btn-return-home"
                                   onAction="#goToIdle">
                            <graphic>
                                   <FontIcon iconLiteral="fas-arrow-left" iconSize="14"/>
                            </graphic>
                     </Button>

        </VBox>
        

        
        <VBox fx:id="stateErrorDup"
              styleClass="error-card-warning"
              spacing="14"
              alignment="CENTER"
              maxWidth="520"
              visible="false" managed="false">

                     <Label styleClass="error-icon-amber"
                               alignment="CENTER">
                            <graphic>
                                   <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="28"/>
                            </graphic>
                     </Label>

            <Label text="Already Timed In Today"
                   styleClass="error-title"/>

            <Label fx:id="errorDupMessage"
                   text="Marc Soro already recorded a Time In at 08:07:22 AM.
Please use Time Out to end your shift."
                   styleClass="error-message"
                   wrapText="true"
                   maxWidth="400"
                   alignment="CENTER"/>

            
            <VBox styleClass="error-detail-box"
                  spacing="4"
                  maxWidth="9999">
                <Label text="Today's record:" styleClass="error-detail-text"
                       style="-fx-font-weight: bold;"/>
                <Label fx:id="errorDupDetail"
                       text="Time In: 08:07:22 AM   Â·   Time Out: â€”"
                       styleClass="error-detail-text"/>
            </VBox>

                     <Button text="Return to Home"
                                   styleClass="btn-return-home"
                                   onAction="#goToIdle">
                            <graphic>
                                   <FontIcon iconLiteral="fas-arrow-left" iconSize="14"/>
                            </graphic>
                     </Button>

        </VBox>
        

    </StackPane>
    

    
    <HBox styleClass="kiosk-footer"
          alignment="CENTER_LEFT"
          spacing="10">

        <Label text="NU Payroll Kiosk Terminal v2.4  Â·  For employee use only"
               styleClass="footer-text"
               HBox.hgrow="ALWAYS"/>

        <HBox alignment="CENTER_RIGHT" spacing="6">
                     <ImageView styleClass="footer-logo-image"
                                      fitWidth="16" fitHeight="16" preserveRatio="true">
                            <image>
                                   <Image url="@/image/logo.png"/>
                            </image>
                     </ImageView>
            <Label text="National University" styleClass="footer-brand-label"/>
        </HBox>

    </HBox>

</VBox>

